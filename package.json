{
  "name": "@tobiasoberpaul/aip",
  "version": "0.1.0",
  "description": "Local project telemetry for AI-assisted work across Codex and Kiro",
  "type": "module",
  "bin": {
    "aip": "./cli.mjs"
  },
  "exports": {
    "./hook": "./hook.cjs"
  },
  "files": [
    "cli.mjs",
    "init.mjs",
    "hook.cjs",
    "serve.mjs",
    "record.mjs",
    "import-history.mjs",
    "data.mjs",
    "rollout.mjs",
    "app.jsx",
    "styles.css",
    "tailwind.config.cjs",
    "components/",
    "lib/",
    "SHADCN-LICENSE",
    "telemetry/.codex/hooks.json",
    "telemetry/.codex/hooks/context-history.cjs",
    "telemetry/.codex/hooks/context-package-check.cjs",
    "telemetry/.codex/hooks/context-usage.cjs",
    "telemetry/.codex/hooks/performance-store.cjs",
    "telemetry/.kiro/hooks/performance.json",
    "telemetry/.kiro/hooks/performance-run.cjs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tobias-Oberpaul/aip.git"
  },
  "homepage": "https://tobias-oberpaul.github.io/aip/",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "node serve.mjs",
    "import-history": "node import-history.mjs",
    "record": "node record.mjs",
    "test": "node --test history.test.mjs",
    "test:package": "node scripts/test-package.mjs",
    "build:site": "node scripts/build-site.mjs"
  },
  "dependencies": {
    "@radix-ui/react-collapsible": "1.2.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slot": "1.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "esbuild": "0.21.5",
    "lucide-react": "1.66.0",
    "postcss": "8.5.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tailwind-merge": "2.6.0",
    "tailwindcss": "3.4.17"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "MIT",
  "devDependencies": {
    "@radix-ui/react-tooltip": "1.4.1",
    "@tobiasoberpaul/mdk": "0.5.0"
  }
}
